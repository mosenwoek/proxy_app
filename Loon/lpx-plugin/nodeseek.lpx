#!name=NodeSeek 签到
#!desc=NodeSeek 每日签到领鸡腿，支持多账号、余额查询、Cookie 自动抓取。账号存 BoxJS，Loon / Surge / Egern 通用。
#!author=mosen[https://github.com/mosenwoek],moyan[https://t.me/tgxiaoxizf_bot]
#!homepage=https://github.com/mosenwoek/proxy_app
#!icon=https://www.nodeseek.com/static/image/favicon.ico
#!tag=签到,工具
#!loon_version=3.5.1(983)
#!date=2026-10-18
#!type=normal

# ─────────────────────────────────────────────────────────────
#  使用流程
#  ────────
#   1. 装插件 → 打开「抓 Cookie」开关
#   2. 浏览器打开 www.nodeseek.com → 点右上角自己的头像（弹出名片）
#   3. 弹「XX 抓取成功」即入库，然后关掉抓 Cookie 开关
#   4. 换账号：退出登录 → 登录下一个号 → 再点头像
#
#  说明
#  ────
#   抓取拦截 GET /api/account/getInfo/{id}?readme=1 的响应体，
#   从中取 member_id / member_name，Cookie 取请求头整份存档。
#   签到打 POST /api/attendance?random=<true|false>。
#
#  为什么需要 [Mitm]
#   抓 Cookie 必须解密 HTTPS，所以 nodeseek.com 要列入 MitM。
#   只跑签到不抓 Cookie 时，MitM 可以关掉。
# ─────────────────────────────────────────────────────────────

[Argument]
ns_task    = switch,true,tag=每日签到,desc=关闭后只跑抓取，不执行签到
ns_capture = switch,false,tag=抓Cookie,desc=开启后浏览 nodeseek.com 点自己头像即自动入库
ns_random  = switch,false,tag=随机鸡腿,desc=关闭=固定 5 个鸡腿，开启=随机发放
ns_notify  = switch,true,tag=运行通知,desc=签到结果推送到系统通知
ns_debug   = switch,false,tag=调试模式,desc=输出请求、余额、解析过程等日志
ns_cron    = input,"30 8 * * *",tag=签到定时,desc=五段 Cron：分 时 日 月 周

[Script]
# 抓 Cookie：命中个人名片接口的响应，requires_body 必须开
response if ${url} ~= /^https:\/\/www\.nodeseek\.com\/api\/account\/getInfo\// then script("https://raw.githubusercontent.com/mosenwoek/proxy_app/refs/heads/main/All-Task.js/NodeSeek_Task.js") with enable=${ns_capture}, requires_body=true, tag="NodeSeek·抓Cookie"
# 定时签到
cron ${ns_cron} then script("https://raw.githubusercontent.com/mosenwoek/proxy_app/refs/heads/main/All-Task.js/NodeSeek_Task.js") with enable=${ns_task}, tag="NodeSeek·签到", timeout=120

[Mitm]
hostname = www.nodeseek.com
