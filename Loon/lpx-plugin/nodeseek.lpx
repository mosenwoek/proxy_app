#!name=NodeSeek 签到
#!desc=NodeSeek 每日签到领鸡腿，支持多账号、余额查询、Cookie 自动抓取。账号存 BoxJS，Loon / Surge / Egern 通用。
#!author=mosen[https://github.com/mosenwoek],moyan[https://t.me/tgxiaoxizf_bot]
#!homepage=https://github.com/mosenwoek/proxy_app
#!icon=https://raw.githubusercontent.com/mosenwoek/icons/refs/heads/main/NodeSeek.png?v=20261018
#!tag=签到,工具
#!loon_version=3.5.1(983)
#!date=2026-10-18
#!type=normal

# ─────────────────────────────────────────────────────────────
#  使用流程
#  ────────
#   1. 装插件 → 打开「抓Cookie」开关
#   2. 浏览器打开 www.nodeseek.com → 点右上角自己的头像（弹出名片）
#   3. 弹「XX 抓取成功」即入库，然后关掉抓Cookie开关
#   4. 换账号：退出登录 → 登录下一个号 → 再点头像
#
#  开关优先级（重要）
#  ──────────────
#   插件里的开关 = 本次运行的参数，优先级最高；
#   插件没传参（旧版 Loon）时才回落到 BoxJS 里同名的键。
#   两边都开/都关时以插件为准。想长期改默认值就改 BoxJS。
#
#  为什么需要 [Mitm]
#   抓 Cookie 必须解密 HTTPS，所以 nodeseek.com 要列入 MitM。
#   只跑签到不抓 Cookie 时，MitM 可以关掉。
# ─────────────────────────────────────────────────────────────

[Argument]
enable_checkin = switch,true,tag=每日签到,desc=关闭后只查询余额，不执行签到
enable_capture = switch,false,tag=抓Cookie,desc=开启后浏览 nodeseek.com 点自己头像即自动入库
random_gift    = switch,false,tag=随机鸡腿,desc=关闭=固定 5 个鸡腿，开启=随机发放
enable_notify  = switch,true,tag=运行通知,desc=签到结果推送到系统通知
enable_debug   = switch,false,tag=调试模式,desc=输出请求、余额、解析过程等日志
ns_cron        = input,"30 8 * * *",tag=签到定时,desc=五段 Cron：分 时 日 月 周

[Script]
# 抓 Cookie：命中个人名片接口的响应，requires_body 必须开
response if ${url} ~= /^https:\/\/www\.nodeseek\.com\/api\/account\/getInfo\// then script("https://raw.githubusercontent.com/mosenwoek/proxy_app/refs/heads/main/All-Task.js/NodeSeek_Task.js", {${enable_checkin}, ${enable_capture}, ${random_gift}, ${enable_notify}, ${enable_debug}}) with enable=${enable_capture}, requires_body=true, tag="NodeSeek·抓Cookie"

# 定时签到
cron ${ns_cron} then script("https://raw.githubusercontent.com/mosenwoek/proxy_app/refs/heads/main/All-Task.js/NodeSeek_Task.js", {${enable_checkin}, ${enable_capture}, ${random_gift}, ${enable_notify}, ${enable_debug}}) with enable=${enable_checkin}, tag="NodeSeek·签到", timeout=120

[Mitm]
hostname = www.nodeseek.com
