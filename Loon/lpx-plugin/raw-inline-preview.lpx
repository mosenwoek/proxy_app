#!name=预览loon插件qx脚本
#!desc=让浏览器直接渲染 raw 链接的lpx,plugin,snippet文件，不触发下载。感谢老中医提供的思路 @dcpeng
#!author=@mosen[https://github.com/mosenwoek], @moyan[https://t.me/tgxiaoxizf_bot]
#!homepage=https://github.com/mosenwoek/proxy_app
#!icon=https://raw.githubusercontent.com/mosenwoek/icons/refs/heads/main/BoxJS.png
#!tag=工具
#!system=ios
#!loon_version=3.5.1
#!date=2026-10-18

[Rewrite]
response if ${url} ~= /^https:\/\/raw\.githubusercontent\.com\//i then response.header.set("Content-Disposition", "inline; filename=\"plugin.txt\"")
response if ${url} ~= /^https:\/\/gist\.githubusercontent\.com\//i then response.header.set("Content-Disposition", "inline; filename=\"plugin.txt\"")

[MitM]
hostname = raw.githubusercontent.com, gist.githubusercontent.com
