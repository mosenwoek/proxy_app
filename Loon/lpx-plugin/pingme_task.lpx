#!name=PingMe 签到
#!desc=每天 6 次自动签到 + 看视频任务（3/8/12/16/20/23 点）。账号数据存在 BoxJS 的 pingme_accounts_v1，与 Egern / Surge 通用，不用重新抓包。
#!author=mosen
#!homepage=https://github.com/mosenwoek/proxy_app
#!icon=https://raw.githubusercontent.com/Aswoth/Keek/main/icon.png
#!tag=签到,工具
#!loon_version=3.5.1(983)
#!date=2026-10-18
#!type=normal

# ─────────────────────────────────────────────────────────────
#  安装前必改：把下面 cron 里的脚本地址换成本地脚本页里那条
#  不改的话 Loon 会去拉作者的原始地址（没有 BoxJS 适配，读不到共享的账号库）
#
#  运行时间表：0 8,12,16,20,23,3 * * *   （共 6 次）
#    03:00 ── 04:00   隔 5 小时
#    08:00 ── 09:00   隔 4 小时
#    12:00 ── 13:00   隔 4 小时
#    16:00 ── 17:00   隔 4 小时
#    20:00 ── 21:00   隔 3 小时   ← 最密的一档
#    23:00 ── 00:00   隔 4 小时，然后跨夜回到 03:00
#
#  为什么排 6 次而不是 1 次：
#    Loon 挂在后台时 iOS 可能把它挂起，单次 cron 一旦错过当天就没签上。
#    6 次是"多次兜底"——签到接口本身幂等，已签过会返回"已签到"，
#    脚本识别后不会重复领奖励，只是多跑几遍而已。
# ─────────────────────────────────────────────────────────────

[Script]

# 每天 6 次：03/08/12/16/20/23 点整（五段 Cron：分 时 日 月 周）
# timeout=300 是必须的：原版脚本每个视频之间有 35~43 秒随机延时，
# 5 个视频最多要等 3 分半，超时给少了会被 Loon 半路掐断。
cron "0 8,12,16,20,23,3 * * *" then script("https://raw.githubusercontent.com/mosenwoek/proxy_app/refs/heads/main/All-Task.js/PingMe_Task.js") with tag="PingMe 签到", timeout=300, img_url="https://raw.githubusercontent.com/Aswoth/Keek/main/icon.png"

# ─────────────────────────────────────────────────────────────
#  不需要 [Mitm]
#  脚本是用 $httpClient 主动去请求 api.pingmeapp.net 的，
#  不拦截系统流量、不读 $request，所以既不装证书也不需要 MitM 域名。
# ─────────────────────────────────────────────────────────────
