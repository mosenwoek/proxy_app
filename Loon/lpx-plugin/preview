# Loon 插件：浏览器直接预览 .lpx/.plugin/.snippet 等插件文件
#!name=预览loon插件qx脚本raw-inline-preview
#!desc=让 浏览器 直接渲染插件文件，不触发下载
#!loon_version=3.5.1
#!system=ios

[General]
response if ${url} ~= /^https:\/\/raw\.githubusercontent\.com\//i then response.header.set("Content-Disposition", "inline; filename=\"${url}\"")

[General]
response if ${url} ~= /^https:\/\/gist\.githubusercontent\.com\//i then response.header.set("Content-Disposition", "inline")
