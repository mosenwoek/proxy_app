#!name=HCNSEC签到
#!desc=JWT Token模式，首次需网页登录获取Token
#!author=mosen
#!homepage=https://github.com/mosenwoek/proxy_app
#!icon=https://api.hcnsec.cn/favicon.ico
#!tag=签到

[Script]
http-request ^https:\/\/api\.hcnsec\.cn\/api\/user\/self script-path=https://raw.githubusercontent.com/mosenwoek/proxy_app/refs/heads/main/Surge/sgmodule/hcnsec_cron.js, requires-body=false, tag=HCNSEC获取Token

cron "0 9 * * *" script-path=https://raw.githubusercontent.com/mosenwoek/proxy_app/refs/heads/main/Surge/sgmodule/hcnsec_cron.js, tag=HCNSEC签到, timeout=120, img-url=https://api.hcnsec.cn/favicon.ico, enable=true

[MitM]
hostname = api.hcnsec.cn
