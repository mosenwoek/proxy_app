#!name=小浣熊 OpenAI 反代
#!desc=把商汤小浣熊额度变成 OpenAI 兼容 API（/v1/chat/completions、/v1/models），附每日自动签到领积分。账密自动登录、token 缓存、过期自动续期，Minis 等任何 OpenAI 协议客户端可用。
#!author=LinkPass888[https://github.com/LinkPass888],mosen[https://github.com/mosenwoek],moyan[https://t.me/tgxiaoxizf_bot]
#!homepage=https://github.com/mosenwoek/proxy_app
#!icon=https://raw.githubusercontent.com/mosenwoek/icons/refs/heads/main/xiaohuanxiong.png?v=20261019b
#!tag=签到,工具
#!loon_version=3.5.1(983)
#!date=2026-10-19
#!type=normal

# ─────────────────────────────────────────────────────────────
#  使用说明
#  ────────
#  1. [Argument] 填手机号 + 密码（自动登录），或直接填 token
#  2. 签到：cron 每天自动跑 +300 积分，通知可关
#  3. 反代：Minis 里 Base URL 填 https://xiaohuanxiong.com/v1
#     （关闭"追加 /v1 后缀"），API Key 随便填不校验
#  4. 模型名随便写（如 gpt-4o），脚本自动映射到小浣熊真实模型
#
#  为什么需要 MitM
#  ──────────
#  /v1/* 反代靠请求改写（登录态注入 + 模型名映射）实现，
#  xiaohuanxiong.com 必须在 MitM 列表。签到 cron 不依赖 MitM。
# ─────────────────────────────────────────────────────────────

[Argument]
nation  = input,"86",tag=区号,desc=手机号区号，默认 86
phone   = input,none,tag=手机号,desc=填了自动登录；或改填下方 token
password = input,none,tag=密码,desc=配合手机号使用
token   = input,none,tag=Token,desc=填了跳过登录，直接使用（最稳）
xhx_cron = input,"12 0 * * *",tag=签到定时,desc=五段 Cron：分 时 日 月 周
notify  = switch,true,tag=运行通知,desc=签到结果推送到系统通知

[Script]
request if ${url} ~= /^https:\/\/xiaohuanxiong\.com\/v1\/(chat\/completions|models|checkin|probe)/ then script("https://raw.githubusercontent.com/mosenwoek/proxy_app/refs/heads/main/js/raccoon-openai.js", {${nation}, ${phone}, ${password}, ${token}, ${notify}}) with requires_body=true, tag="小浣熊反代"
cron ${xhx_cron} then script("https://raw.githubusercontent.com/mosenwoek/proxy_app/refs/heads/main/js/raccoon-openai.js", {${nation}, ${phone}, ${password}, ${token}, ${notify}}) with tag="小浣熊签到", timeout=120

[Mitm]
hostname = %APPEND% xiaohuanxiong.com
