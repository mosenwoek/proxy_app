{
  "id": "mosen.pingme.wetalk",
  "name": "mosen & Boxjs脚本订阅",
  "author": "@Aswoth, @luckyday, BoxJS适配 @mosen",
  "icon": "https://raw.githubusercontent.com/axhani/icon/refs/heads/main/pingme&wetalk.png",
  "repo": "https://github.com/mosenwoek/proxy_app",
  "updateTime": "2026-10-18 05:00:00",
  "apps": [
    {
      "id": "mosen.pingme",
      "name": "PingMe",
      "keys": [
        "pingme_accounts_v1",
        "pingme_daily_stats_v1",
        "pingme_clear",
        "pingme_debug",
        "pingme_run_email"
      ],
      "settings": [
        {
          "id": "pingme_accounts_v1",
          "name": "账号库（capture JSON）",
          "val": "",
          "type": "textarea",
          "placeholder": "粘贴从 Egern / Loon / Surge 导出的 pingme_accounts_v1 原始 JSON",
          "desc": "整份账号库 JSON。跨 App 共享的核心键：任一 App 的 BoxJS 里粘贴，另一个 App 立即可用。备份/恢复也只备这一个键"
        },
        {
          "id": "pingme_clear",
          "name": "清空账号库",
          "val": false,
          "type": "boolean",
          "desc": "开启后运行一次脚本会清空 pingme_accounts_v1，完成后自动复位为关闭"
        },
        {
          "id": "pingme_run_email",
          "name": "只跑指定邮箱（留空跑全部）",
          "val": "",
          "type": "text",
          "placeholder": "a@x.com,b@y.com",
          "desc": "多个用逗号分隔；留空执行账号库里全部账号。插件里的邮箱参数优先级更高"
        },
        {
          "id": "pingme_debug",
          "name": "调试模式",
          "val": "false",
          "type": "selects",
          "items": [
            {
              "key": "false",
              "label": "关闭"
            },
            {
              "key": "true",
              "label": "开启"
            }
          ],
          "desc": "开启后脚本输出合并来源、账号数、UA、请求路径等诊断日志"
        }
      ],
      "author": "@Aswoth, BoxJS适配 @mosen",
      "repo": "https://github.com/mosenwoek/proxy_app",
      "script": "https://raw.githubusercontent.com/mosenwoek/proxy_app/refs/heads/main/All-Task.js/PingMe_Task.js",
      "icons": [
        "https://raw.githubusercontent.com/mosenwoek/proxy_app/refs/heads/main/All-Task.js/icons/PingMe.png",
        "https://raw.githubusercontent.com/mosenwoek/proxy_app/refs/heads/main/All-Task.js/icons/PingMe.png"
      ],
      "icon": "https://raw.githubusercontent.com/mosenwoek/proxy_app/refs/heads/main/All-Task.js/icons/PingMe.png"
    },
    {
      "id": "mosen.wetalk",
      "name": "WeTalk",
      "keys": [
        "wetalk_accounts_v1",
        "wetalk_daily_stats_v1",
        "wetalk_clear",
        "wetalk_debug"
      ],
      "settings": [
        {
          "id": "wetalk_accounts_v1",
          "name": "账号库（capture JSON）",
          "val": "",
          "type": "textarea",
          "placeholder": "粘贴从任一 App 导出的 wetalk_accounts_v1 原始 JSON",
          "desc": "WeTalk 的账号库，结构与 PingMe 相同（capture.paramsRaw + capture.headers + baseUA + uaSeed）。和 PingMe 一样可以跨 App 粘贴共享"
        },
        {
          "id": "wetalk_clear",
          "name": "清空账号库",
          "val": false,
          "type": "boolean",
          "desc": "开启后运行一次脚本会清空 wetalk_accounts_v1，完成后自动复位为关闭"
        },
        {
          "id": "wetalk_debug",
          "name": "调试模式",
          "val": "false",
          "type": "selects",
          "items": [
            {
              "key": "false",
              "label": "关闭"
            },
            {
              "key": "true",
              "label": "开启"
            }
          ],
          "desc": "开启后输出详细日志"
        }
      ],
      "author": "@luckyday",
      "repo": "https://github.com/mosenwoek/proxy_app",
      "script": "https://raw.githubusercontent.com/mosenwoek/proxy_app/refs/heads/main/All-Task.js/WeTalk_Task.js",
      "icons": [
        "https://raw.githubusercontent.com/mosenwoek/proxy_app/refs/heads/main/All-Task.js/icons/WeTalk.png",
        "https://raw.githubusercontent.com/mosenwoek/proxy_app/refs/heads/main/All-Task.js/icons/WeTalk.png"
      ],
      "icon": "https://raw.githubusercontent.com/mosenwoek/proxy_app/refs/heads/main/All-Task.js/icons/WeTalk.png"
    },
    {
      "id": "mosen.agentrouter",
      "name": "AgentRouter",
      "keys": [
        "agentrouter_accounts_v1",
        "agentrouter_sync",
        "agentrouter_username",
        "agentrouter_password",
        "agentrouter_clear",
        "agentrouter_debug"
      ],
      "settings": [
        {
          "id": "agentrouter_accounts_v1",
          "name": "账号库（JSON 数组）",
          "val": "",
          "type": "textarea",
          "placeholder": "[\n  {\"username\": \"a@example.com\", \"password\": \"密码1\"},\n  {\"username\": \"b@example.com\", \"password\": \"密码2\"}\n]",
          "desc": "多账号列表，每项包含 username 与 password。留空时回落到下面的单账号字段。⚠️ 备份文件里含明文密码，请勿分享"
        },
        {
          "id": "agentrouter_username",
          "name": "账号（单账号兼容）",
          "val": "",
          "type": "text",
          "placeholder": "网站账号或邮箱",
          "desc": "只在「账号库」为空时使用"
        },
        {
          "id": "agentrouter_password",
          "name": "密码（单账号兼容）",
          "val": "",
          "type": "text",
          "placeholder": "网站登录密码",
          "desc": "单独填写密码，首尾空格会保留；不要分享含账号密码的 BoxJS 备份"
        },
        {
          "id": "agentrouter_sync",
          "name": "从 Loon 插件同步进来",
          "val": false,
          "type": "boolean",
          "desc": "开启后运行一次脚本，会把 Loon 插件设置里填的账号并入本账号库（同名覆盖），完成后自动关闭。用于从插件配置迁移到 BoxJS"
        },
        {
          "id": "agentrouter_clear",
          "name": "清除账号信息",
          "val": false,
          "type": "boolean",
          "desc": "开启后运行一次脚本会清空账号库和单账号字段并自动关闭，不发起签到"
        },
        {
          "id": "agentrouter_debug",
          "name": "调试模式",
          "val": "false",
          "type": "selects",
          "items": [
            {
              "key": "false",
              "label": "关闭"
            },
            {
              "key": "true",
              "label": "开启"
            }
          ],
          "desc": "仅打印 HTTP 状态和签到判定，不打印账号密码、Cookie 或完整响应"
        }
      ],
      "author": "@773075692, 移植 @MaYIHEI, 多账号 @mosen",
      "repo": "https://github.com/mosenwoek/proxy_app",
      "script": "https://raw.githubusercontent.com/mosenwoek/proxy_app/refs/heads/main/All-Task.js/AgentRouter_Task.js",
      "icons": [
        "https://raw.githubusercontent.com/mosenwoek/proxy_app/refs/heads/main/All-Task.js/icons/AgentRouter.png",
        "https://raw.githubusercontent.com/mosenwoek/proxy_app/refs/heads/main/All-Task.js/icons/AgentRouter.png"
      ],
      "icon": "https://raw.githubusercontent.com/mosenwoek/proxy_app/refs/heads/main/All-Task.js/icons/AgentRouter.png"
    }
  ]
}